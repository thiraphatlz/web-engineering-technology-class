datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Book {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  publishedAt DateTime @default(now())
  coverUrl    String?
  reviews     Review[]
}

model Review {
  id      Int    @id @default(autoincrement())
  rating  Int
  comment String
  bookId  Int
  book    Book   @relation(fields: [bookId], references: [id])
}
